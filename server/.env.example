# PostgreSQL connection for development
DATABASE_URL=postgres://user:password@localhost:5432/polls_dev
# Separate test database; must differ from DATABASE_URL
DATABASE_URL_TEST=postgres://user:password@localhost:5432/polls_test
# Secret for signing JWTs (used once Register and log in ships)
JWT_SECRET=change-me
# Origin of the React client, allowed by CORS
CLIENT_URL=http://localhost:5173
PORT=3000
NODE_ENV=development
# Username of the fixed test user who acts as the logged-in user until Register and log in ships
TEST_USER_USERNAME=test-user
